# Copy this file to .env and fill in your values.
# Leave DB_NAME blank to use SQLite automatically (fastest way to start).

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (optional, fill in once your Postgres install is working) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
